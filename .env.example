# Supabase Configuration - PRODUÇÃO
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...

# Supabase Configuration - DESENVOLVIMENTO (opcional)
# Se não definido, usa as credenciais de produção
VITE_SUPABASE_DEV_URL=https://yyyyy.supabase.co
VITE_SUPABASE_DEV_ANON_KEY=eyJyyy...

# Supabase Service Role (Backend only)
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# Server Configuration
PORT=4000
NODE_ENV=production

# Optional
WEBHOOK_SECRET=seu_secret_opcional